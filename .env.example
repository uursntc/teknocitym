# Yönetim paneli şifresi (zorunlu). Güçlü bir şifre seç.
ADMIN_PASSWORD=degistir-beni

# Oturum çerezini imzalamak için uzun, rastgele bir metin (önerilir).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# İsteğe bağlı: verilerin saklanacağı klasör (varsayılan: ./data)
# DATA_DIR=/var/lib/teknocitym
